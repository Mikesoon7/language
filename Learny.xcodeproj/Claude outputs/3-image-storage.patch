 public class WordsEntity: NSManagedObject {
 
 }
+
+extension WordsEntity {
+    /// Photo of the card, or nil when the card has none.
+    var imageDetails: ImageDetailsCheck? {
+        guard let image else { return nil }
+        return ImageDetailsCheck(
+            imageData: image,
+            contentMode: ImageContentMode(rawValue: Int(imageContentMode)) ?? .fill,
+            filterValue: ImageFilterMode(rawValue: Int(imageFilter)) ?? .original)
+    }
+
+    /// Single place that knows how a photo is laid out in the three attributes.
+    func setImageDetails(_ details: ImageDetailsCheck?) {
+        image = details?.imageData
+        imageContentMode = Int16(details?.contentMode.rawValue ?? ImageContentMode.fill.rawValue)
+        imageFilter = Int16(details?.filterValue.rawValue ?? ImageFilterMode.original.rawValue)
+    }
+}
